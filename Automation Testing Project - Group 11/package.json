{
    "name": "dienmayxanh-automation-group-11",
    "version": "1.0.0",
    "private": true,
    "description": "Automation Testing Project - Group 11 - https://www.dienmayxanh.com (Playwright + TypeScript)",
    "scripts": {
        "test": "playwright test",
        "test:login": "playwright test tests/login",
        "test:mega-menu": "playwright test tests/mega-menu",
        "test:product-list": "playwright test tests/product-list",
        "test:voucher": "playwright test tests/voucher",
        "test:store-locator": "playwright test tests/store-locator",
        "test:cart": "playwright test tests/cart",
        "test:headed": "playwright test --headed",
        "test:list": "playwright test --list",
        "typecheck": "tsc --noEmit",
        "summary": "node scripts/summarize.js",
        "report": "playwright show-report \"../Test Report - Group 11/html\"",
        "auth": "playwright codegen --save-storage=auth/dmx_storageState.json https://www.dienmayxanh.com"
    },
    "devDependencies": {
        "@playwright/test": "1.63.0",
        "@types/node": "^22.0.0",
        "typescript": "^5.6.0"
    }
}